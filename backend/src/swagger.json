              }
            }
          },
          "500": {
            "description": "Lỗi server",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/friends/requests/{requestId}/decline": {
      "post": {
        "summary": "DeclineFriendRequest",
        "description": "Từ chối lời mời kết bạn theo ID. Chỉ người nhận lời mời mới có quyền từ chối. Bản ghi `FriendRequest` sẽ bị xóa. Trả về `204 No Content` nếu thành công.",
        "tags": ["Friends"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId của lời mời kết bạn",
            "schema": {
              "type": "string",
              "example": "64f1a2b3c4d5e6f7a8b9c0d1"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Từ chối thành công"
          },
          "401": {
            "description": "Chưa xác thực",
