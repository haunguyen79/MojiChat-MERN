    "/conversations/": {
      "post": {
        "summary": "CreateConversation",
        "description": "Tạo cuộc trò chuyện mới. Nếu `type` là `direct` và cuộc trò chuyện giữa 2 người đã tồn tại, trả về cuộc trò chuyện hiện có. Nếu `type` là `group`, phải cung cấp thêm `name`. Middleware kiểm tra quan hệ bạn bè trước khi tạo.",
        "tags": ["Conversations"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["type", "memberIds"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["direct", "group"],
                    "example": "group"
                  },
                  "name": {
                    "type": "string",
                    "description": "Tên nhóm (bắt buộc khi type = group)",
                    "example": "Nhóm ABC"
                  },
                  "memberIds": {
                    "type": "array",
                    "description": "Danh sách ID các thành viên (không bao gồm người tạo)",
                    "items": {
                      "type": "string"
                    },
                    "example": ["69a7fd6ee511bdd62b719145", "69998974c0e73e6753e31937"]
                  }
                }
              },
              "examples": {
                "createGroup": {
                  "summary": "Tạo cuộc trò chuyện nhóm",
                  "value": {
                    "type": "group",
                    "name": "Nhóm ABC",
                    "memberIds": ["69a7fd6ee511bdd62b719145"]
                  }
                },
                "createDirect": {
                  "summary": "Tạo cuộc trò chuyện trực tiếp",
                  "value": {
                    "type": "direct",
                    "memberIds": ["69998974c0e73e6753e31937"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tạo hoặc lấy cuộc trò chuyện thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "conversation": {
                      "$ref": "#/components/schemas/Conversation"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu đầu vào không hợp lệ (thiếu name cho group, memberIds rỗng, type không hợp lệ)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Tên nhóm và danh sách thành viên là bắt buộc" }
              }
            }
          },
          "401": {
            "description": "Chưa xác thực",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Lỗi server",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "get": {
        "summary": "GetConversations",
        "description": "Lấy danh sách tất cả cuộc trò chuyện của người dùng hiện tại, sắp xếp theo tin nhắn mới nhất trước (`lastMessageAt` giảm dần).",
        "tags": ["Conversations"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lấy danh sách thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "conversations": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Conversation"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Chưa xác thực",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Lỗi server",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/conversations/{conversationId}/messages": {
      "get": {
        "summary": "GetMessages",
        "description": "Lấy danh sách tin nhắn của một cuộc trò chuyện theo ID. Hỗ trợ phân trang kiểu cursor-based. Mặc định trả về 50 tin nhắn mới nhất, sắp xếp từ cũ đến mới. Nếu còn tin nhắn cũ hơn, `nextCursor` sẽ được trả về để dùng cho lần truy vấn tiếp theo.",
        "tags": ["Conversations"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "description": "MongoDB ObjectId của cuộc trò chuyện",
            "schema": {
              "type": "string",
              "example": "68fb2e6a19c501587577291c"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Số lượng tin nhắn tối đa trả về (mặc định: 50)",
            "schema": {
              "type": "integer",
              "default": 50,
              "example": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Cursor từ response trước để tải thêm tin nhắn cũ hơn (là `_id` của tin nhắn cũ nhất đã nhận)",
            "schema": {
              "type": "string",
              "example": "64f1a2b3c4d5e6f7a8b9c0d1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lấy tin nhắn thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messages": {
                      "type": "array",
                      "description": "Danh sách tin nhắn, sắp xếp từ cũ đến mới",
                      "items": {
                        "$ref": "#/components/schemas/Message"
                      }
                    },
                    "nextCursor": {
                      "type": "string",
                      "nullable": true,
                      "description": "Cursor để load thêm tin nhắn cũ hơn. Null nếu đã hết.",
                      "example": "64f0a1b2c3d4e5f6a7b8c9d0"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Chưa xác thực",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Lỗi server",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/messages/direct": {
      "post": {
        "summary": "SendDirectMessage",
        "description": "Gửi tin nhắn trực tiếp tới một user. Có thể truyền `conversationId` nếu cuộc trò chuyện đã tồn tại, hoặc chỉ cần `recipientId` để tự động tạo mới. Middleware kiểm tra quan hệ bạn bè trước khi gửi.",
        "tags": ["Messages"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["content"],
                "properties": {
                  "recipientId": {
                    "type": "string",
                    "description": "ID người nhận (bắt buộc nếu không có conversationId)",
                    "example": "69a19399ff2664c2bd9657ef"
                  },
                  "conversationId": {
                    "type": "string",
                    "description": "ID cuộc trò chuyện hiện có (nếu đã biết)",
                    "example": "68fb2e6a19c501587577291c"
                  },
                  "content": {
                    "type": "string",
                    "description": "Nội dung tin nhắn",
                    "example": "Xin chào!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Gửi tin nhắn thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "$ref": "#/components/schemas/Message"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Thiếu nội dung tin nhắn",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "message": "Thiếu nội dung" }
              }
            }
          },
          "401": {
            "description": "Chưa xác thực",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Lỗi server",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
